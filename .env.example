# R2 S3-compatible API credentials for the daily digest fetch.
# Create at: Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token
# (Object Read only, scoped to the extraextra-mail bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=extraextra-mail
# The inbox address your routing rule sends to the worker — used by
# scripts/scan-recipients.mjs to tell direct mail from forwarded mail.
INBOX_ADDRESS=read@yourdomain.com
